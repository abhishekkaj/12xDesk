// This is the 12xDesk CRM Prisma schema
// Database: SQLite (local-first, zero-config)
// Models: Lead, Property, Interaction

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Lead (Inquiry) ───────────────────────────────────────────────
model Lead {
  id            String        @id @default(cuid())
  name          String
  phone         String        // Indian mobile: +91XXXXXXXXXX
  source        String        // Facebook, WhatsApp, Walk-in, 99acres, MagicBricks, Housing.com, Referral
  budget        String?       // e.g. "80L - 1.2Cr"
  requirement   String?       // e.g. "2BHK in Thane West"
  pipelineStage String        @default("NEW_LEAD") @map("pipeline_stage")
  // Stages: NEW_LEAD, REQUIREMENT_GATHERED, SITE_VISIT_SCHEDULED, SITE_VISIT_DONE, TOKEN_NEGOTIATION, CLOSED_WON, CLOSED_LOST
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  interactions  Interaction[]

  @@map("leads")
}

// ─── Property (Inventory) ─────────────────────────────────────────
model Property {
  id                  String   @id @default(cuid())
  projectName         String   @map("project_name")
  developer           String
  location            String
  configuration       String   // 1BHK, 2BHK, 3BHK, etc.
  possessionTimeline  String?  @map("possession_timeline") // e.g. "Q4 2027"
  basePrice           String?  @map("base_price") // e.g. "55L onwards"
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("properties")
}

// ─── Interaction (Activity Log) ───────────────────────────────────
model Interaction {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  type      String   // WHATSAPP, CALL, SITE_VISIT
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("interactions")
}

// ─── NextAuth Models ──────────────────────────────────────────────
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // For CredentialsProvider
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
